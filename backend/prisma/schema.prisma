generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  c_id    Int       @id @default(autoincrement())
  name    String    @unique
  Vehicle Vehicle[]
  booking booking[]
}

model Vehicle {
  v_id            Int                 @id @default(autoincrement())
  name            String
  brand           String
  model           String
  description     String?
  licensePlate    String              @unique
  vin             String?             @unique
  mileage         Int?
  fuelType        VehicleFuelType     @default(PETROL)
  transmission    VehicleTransmission @default(MANUAL)
  seatingCapacity Int
  dailyRate       Decimal             @db.Decimal(10, 2)
  status          VehicleStatus       @default(AVAILABLE)
  image           String?
  image1          String?
  image2          String?
  categoryId      Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime
  Category        Category            @relation(fields: [categoryId], references: [c_id])
  booking         booking[]
}

model admin {
  adminId    Int      @id @default(autoincrement())
  ownername  String   @unique
  email      String   @unique
  passowrd   String
  verified   Boolean  @default(false)
  otpVerify  String?  @default("")
  otpExpired BigInt?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  role       Role     @default(admin)
  login      login[]
}

model booking {
  bookingId      Int            @id @default(autoincrement())
  bookingDate    DateTime
  returnDate     DateTime
  username       String         @default("")
  useremail      String
  vehicleId      Int
  vehicleName    String?
  categoryName   String?
  categoryId     Int
  price          Decimal        @db.Decimal(10, 2)
  pickuplocation String
  droplocation   String
  licenseNo      String
  licenseImg     String?
  paymentMethod  PaymentMethod  @default(cashOnDelivery)
  paymentStatus  Payment        @default(pending)
  deliverystatus DeliveryStatus @default(pending)
  createdAt      DateTime       @default(now())
  updateAt       DateTime       @default(now())
  Category       Category       @relation(fields: [categoryId], references: [c_id])
  user           user           @relation(fields: [useremail], references: [email])
  Vehicle        Vehicle        @relation(fields: [vehicleId], references: [v_id])
}

model login {
  loginId      Int    @id @default(autoincrement())
  userId       Int?
  adminId      Int?
  refreshToken String @unique
  email        String
  password     String
  role         Role
  admin        admin? @relation(fields: [adminId], references: [adminId])
  user         user?  @relation(fields: [userId], references: [userId])
}

model user {
  userId          Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  verified        Boolean   @default(false)
  otpVerify       String?   @default("")
  otpExpired      DateTime?
  updateOtp       String?
  updateOtpExpire DateTime?
  resetOtp        String?   @default("")
  resetOtpExpired DateTime?
  password        String
  role            Role      @default(user)
  createdAt       DateTime  @default(now())
  updateAt        DateTime  @default(now())
  booking         booking[]
  login           login[]
}

enum DeliveryStatus {
  pending
  dilivered
  cancled
}

enum Payment {
  pending
  hold
  completed
}

enum PaymentMethod {
  eSewa
  khalti
  fonePay
  cashOnDelivery
}

enum Role {
  user
  admin
  superadmin
}

enum VehicleFuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
}

enum vechileType {
  Automatic
  Manual
}
